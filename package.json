{
  "name": "pi-better-web-search",
  "version": "0.1.3",
  "description": "A better provider-native web_search tool for pi: raw results, automatic provider fallback, URL analysis, and native DeepSeek Search/Fetch.",
  "type": "module",
  "license": "MIT",
  "author": "Jerry (zhexusun10)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhexusun10/pi-better-web-search.git"
  },
  "bugs": {
    "url": "https://github.com/zhexusun10/pi-better-web-search/issues"
  },
  "homepage": "https://github.com/zhexusun10/pi-better-web-search#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "web-search",
    "websearch",
    "deepseek",
    "ollama",
    "google-gemini",
    "openai",
    "anthropic",
    "xai",
    "provider-fallback",
    "url-context"
  ],
  "files": [
    "extensions/",
    "lib/",
    "docs/",
    "assets/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/zhexusun10/pi-better-web-search/main/assets/architecture.svg"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "22.19.19",
    "typebox": "1.3.27",
    "typescript": "5.9.3"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:live:deepseek": "node scripts/live-deepseek.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "pack": "node scripts/pack.mjs",
    "build": "npm run check && npm test && npm run verify:package && npm run pack",
    "prepublishOnly": "npm run check && npm test && npm run verify:package"
  }
}
