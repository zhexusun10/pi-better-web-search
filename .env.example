# Required for the opt-in live DeepSeek test only.
# Never commit a real key. Use an environment variable or a local .env file.
DEEPSEEK_API_KEY=

# Optional live-test inputs.
PI_BWS_TEST_QUERY=DeepSeek V4 模型 发布
PI_BWS_TEST_URL=https://example.com

# Optional runtime limits.
PI_BETTER_WEB_SEARCH_MAX_CHARS=96000
# Override the default 120-second timeout for each search and URL fetch attempt.
# PI_BETTER_WEB_SEARCH_TIMEOUT_MS=120000

# Optional cache override. Defaults to <pi agent dir>/better-web-search.json.
PI_BETTER_WEB_SEARCH_CACHE=
