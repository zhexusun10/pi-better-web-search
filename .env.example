# Required for the opt-in live DeepSeek test only.
# Never commit a real key. Use an environment variable or a local .env file.
DEEPSEEK_API_KEY=

# Recommended: /pi-better-web-search login in pi's terminal saves a key through
# a masked dialog. Optional environment fallbacks below (saved keys take priority).
# Never paste keys into chat/command arguments or commit the private auth file.
# Perplexity: https://console.perplexity.ai — standard Search API only (not fast).
PERPLEXITY_API_KEY=
# Keenable: https://docs.keenable.ai/api-keys — pro search + live fetch.
# Keyless access is disabled by default; enable explicitly with /web-search-api.
# Saved credentials: <pi agent dir>/better-web-search-auth.json (plaintext, 0600
# where supported). Override with PI_BETTER_WEB_SEARCH_AUTH only outside a repo.
KEENABLE_API_KEY=
# Exa: https://dashboard.exa.ai/api-keys — 10 search results + highlights; full-text fetch.
# Other advanced Exa options remain off. Restart pi after setting.
EXA_API_KEY=

# Optional live-test inputs.
PI_BWS_TEST_QUERY=DeepSeek V4 模型 发布
PI_BWS_TEST_URL=https://example.com

# Optional runtime limits.
PI_BETTER_WEB_SEARCH_MAX_CHARS=96000
# Override the default 120-second timeout for each search and URL fetch attempt.
# PI_BETTER_WEB_SEARCH_TIMEOUT_MS=120000

# Optional cache override. Defaults to <pi agent dir>/better-web-search.json.
PI_BETTER_WEB_SEARCH_CACHE=
